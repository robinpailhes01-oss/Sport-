# Copier en .env.local (jamais commité) pour activer les vraies réponses IA
# de Goggins/Robbins/Oracle dans COMMS. Sans cette clé, l'app retombe
# automatiquement sur le moteur de règles local — rien ne casse.
#
# Clé obtenue sur https://console.anthropic.com
ANTHROPIC_API_KEY=

# Backend Supabase — Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# service_role — TRÈS sensible (bypasse toute RLS). Ne jamais préfixer par
# NEXT_PUBLIC_, ne jamais exposer au client : uniquement lu côté serveur
# (Server Actions Next.js).
SUPABASE_SERVICE_ROLE_KEY=

# Notifications push — générées une fois avec `npx web-push generate-vapid-keys`,
# à garder identiques partout (local + Vercel), sinon les abonnements existants
# cassent silencieusement.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Protège /api/cron/reminders — Vercel Cron l'envoie automatiquement en
# "Authorization: Bearer <CRON_SECRET>" si cette variable est définie sur le
# projet. Génère une valeur aléatoire (`openssl rand -hex 24`), la même en
# local et sur Vercel.
CRON_SECRET=
